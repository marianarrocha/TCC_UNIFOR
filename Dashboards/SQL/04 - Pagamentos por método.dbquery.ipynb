   "source": [
    "SELECT\n",
    "    payment_method_id,\n",
    "    payment_method_type,\n",
    "    SUM(quantidade_pagamentos) AS quantidade_pagamentos,\n",
    "    SUM(valor_total) AS valor_total\n",
    "FROM tcc_unifor.gold.mercado_pago_resumo\n",
    "GROUP BY\n",
    "    payment_method_id,\n",
    "    payment_method_type\n",
    "ORDER BY quantidade_pagamentos DESC;"
   ]
  }
